---
import Picture from '../core/Picture.astro'
import ButtonsProjects from '../core/ButtonsProjects.astro'

const {
  image,
  title,
  descripcion,
  tecnologias = [],
  sitio,
  repositorio,
  aspectRatio = '18:9',
} = Astro.props
---

<div
  class='space-y-8 sm:px-8 flex justify-center p-6 bg-[#EBF3FF] dark:bg-[#244856] rounded'
>
  <div class='flex flex-col w-full max-w-md gap-2'>
    <Picture
      src={image}
      class='pointer-events-none select-none rounded'
      widths={[1000, 500]}
      sizes=' (max-width: 420px) 1000, 500px'
      alt={`Captura de ${title}`}
      aspectRatio={aspectRatio}
    />
    <h2 class='text-3xl md:text-4xl font-bold tracking-tighter mt-2 mb-2'>
      {title}
    </h2>
    <ul class='flex flex-wrap gap-2'>
      {
        tecnologias.map((tecnologia) => (
          <li class='text-sm px-3 py-1 rounded-full bg-white/70 dark:bg-[#0d0d0d]/40'>
            {tecnologia}
          </li>
        ))
      }
    </ul>
    <p class='my-4 flex-1'>
      {descripcion}
    </p>
    <ButtonsProjects hrefView={sitio} hrefCode={repositorio} />
  </div>
</div>
