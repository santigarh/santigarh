---
import BuscadorPelis from '../../assets/images/buscadorPeliculas.jpg'
import RemoveBg from '../../assets/images/removebg.png'
import MindRacer from '../../assets/images/proyectos/mind-racer.png'
import Acordify from '../../assets/images/proyectos/acordify.png'
import DirectorioIglesia from '../../assets/images/proyectos/directorio-iglesia.png'
import BloomEternelle from '../../assets/images/proyectos/bloom-eternelle.png'

import CardProject from './CardProject.astro'
const {} = Astro.props
const proyectos = [
  {
    title: 'Mind Racer',
    image: MindRacer,
    descripcion:
      'Juego de carreras donde el auto acelera con cada cálculo mental correcto. Dificultad adaptativa, bots y salas multijugador en tiempo real para jugar con amigos y familia.',
    tecnologias: ['React', 'TypeScript', 'Vite', 'Node.js', 'WebSockets'],
    repositorio: 'https://github.com/santigarh/mind-racer',
  },
  {
    title: 'Acordify',
    image: Acordify,
    descripcion:
      'Cancionero digital para músicos: canciones con acordes en formato ChordPro, transposición al instante, setlists compartidos y modo presentación. Instalable como PWA y funciona sin conexión.',
    tecnologias: ['React', 'TypeScript', 'Hono', 'Drizzle', 'PostgreSQL'],
    sitio: 'https://acordify-web.vercel.app',
  },
  {
    title: 'manos IST',
    image: DirectorioIglesia,
    descripcion:
      'Directorio donde los miembros de una congregación encuentran servicios, productos y oficios de otros miembros. Búsqueda full-text, contacto por WhatsApp y panel con estadísticas y códigos QR.',
    tecnologias: ['Next.js', 'Supabase', 'Tailwind', 'TypeScript'],
    sitio: 'https://directorio-iglesia.vercel.app',
  },
  {
    title: 'Bloom Eternelle',
    image: BloomEternelle,
    descripcion:
      'Landing page para una tienda de arreglos de flores eternas hechos a mano, con catálogo, personalizador de ramos y pedidos directos por WhatsApp.',
    tecnologias: ['React', 'TypeScript', 'Vite'],
    sitio: 'https://bloom-eternelle.vercel.app',
  },
  {
    title: 'Remove Background',
    image: RemoveBg,
    descripcion:
      'Proyecto que permite quitar el fondo de cualquier imagen usando Cloudinary.',
    tecnologias: ['Svelte', 'TypeScript', 'Tailwind', 'Cloudinary'],
    repositorio: 'https://github.com/santigarh/removeBG',
  },
  {
    title: 'Buscador Películas',
    image: BuscadorPelis,
    descripcion:
      'Proyecto que consume una API para buscar películas y mostrar sus descripciones.',
    tecnologias: ['React', 'Vite', 'JavaScript'],
    repositorio: 'https://github.com/santigarh/BuscadorPeliculas',
  },
]
---

<section id="proyectos" class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
  <div
    class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12 px-6"
  >
    <h1
      class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 text-gray-200"
    >
      Proyectos
    </h1>
    <p
      class="max-w-3xl mx-auto sm:text-center text-xl text-gray-600 dark:text-slate-400"
    >
      Estos son algunos de mis proyectos
    </p>
  </div>
  <div class="grid mx-auto gap-4 space-y-6 md:grid-cols-2 md:space-y-0">
    {
      proyectos.map((proyecto) => (
        <CardProject
          image={proyecto.image}
          title={proyecto.title}
          descripcion={proyecto.descripcion}
          tecnologias={proyecto.tecnologias}
          sitio={proyecto.sitio}
          repositorio={proyecto.repositorio}
        />
      ))
    }
  </div>
</section>
