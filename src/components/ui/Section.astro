---
interface Props {
  id: string
  title: string
  intro?: string
  class?: string
}

const { id, title, intro, class: className } = Astro.props
---

<section
  id={id}
  aria-labelledby={`${id}-titulo`}
  class:list={['mx-auto max-w-page scroll-mt-header px-4 py-20 sm:px-6 lg:py-24', className]}
>
  <header class="mb-10 max-w-2xl" data-reveal>
    <h2 id={`${id}-titulo`} class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
    {intro && <p class="mt-3 text-lg text-muted">{intro}</p>}
  </header>
  <slot />
</section>
