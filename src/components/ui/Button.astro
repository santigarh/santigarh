---
import type { HTMLAttributes } from 'astro/types'
import Icon, { type IconName } from './Icon.astro'

type Props = HTMLAttributes<'a'> & {
  href: string
  variant?: 'primary' | 'secondary' | 'icon'
  icon?: IconName
  iconEnd?: IconName
  external?: boolean
}

const { variant = 'primary', icon, iconEnd, external = false, class: className, ...attrs } = Astro.props

const variants = {
  primary:
    'gap-2 rounded-full bg-accent px-5 py-2.5 font-semibold text-on-accent shadow-sm hover:brightness-110',
  secondary:
    'gap-2 rounded-full border border-border bg-surface px-5 py-2.5 font-semibold text-text hover:border-accent hover:text-accent',
  icon: 'size-11 rounded-full text-muted hover:bg-surface-2 hover:text-text',
}
---

<a
  class:list={[
    'inline-flex items-center justify-center transition duration-200 active:scale-[0.98]',
    variants[variant],
    className,
  ]}
  {...external && { target: '_blank', rel: 'noopener noreferrer' }}
  {...attrs}
>
  {icon && <Icon name={icon} class={variant === 'icon' ? 'size-5' : 'size-4'} />}
  <slot />
  {iconEnd && <Icon name={iconEnd} class="size-4" />}
</a>
